%YAML 1.2
---
# http://www.sublimetext.com/docs/3/syntax.html
name: GitSavvy Diff View
hidden: true
scope: git-savvy.diff_view
contexts:
  main:
    - match: ^
      push: header

  header:
    - meta_scope: comment.header.git_savvy
    - match: '  STAGED CHANGES \(Will commit\)'
      scope: markup.deleted.diff
    - match: '  UNSTAGED CHANGES'
    - match: '^--$\n'
      set: 'scope:git-savvy.diff'
    # The side by side view, see `core/interfaces/diff_split.py`.
    - match: '^==$\n'
      set: split

  split:
    - meta_content_scope: git-savvy.diff-split
    # The line number of the left half ...
    - match: '^ *(\d+)(?= )'
      captures:
        1: comment.line-number.diff-split
    # ... and the divider with the line number of the right half.
    - match: '(\x{2502}) *(\d+)?(?= |$)'
      captures:
        1: comment.divider.diff-split
        2: comment.line-number.diff-split
    # No row of the two columns begins with a "+" or a "-", so of the diff
    # syntax only the headers match.
    - include: 'scope:git-savvy.diff'
