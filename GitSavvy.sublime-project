{
	"build_systems":
	[
		{
			"name": "Reload GitSavvy",
			"target": "gs_reload_modules_debug",
		},
		{
			"name": "Test GitSavvy",
			"target": "unit_testing_current_package",
		},
		{
			"name": "Test GitSavvy (Docker)",
			"shell_cmd": "\"${packages}\\UnitTesting\\docker\\ut-run-tests.cmd\" .",
			"working_dir": "$project_path",
			"file_regex": "^\\s*File \"/root/\\.config/sublime-text/Packages/[^/]+/(.+)\", line ([0-9]+)",
		},
		{
			"name": "Test Current File (Docker)",
			"shell_cmd": "\"${packages}\\UnitTesting\\docker\\ut-run-tests.cmd\" . --file \"${file}\"",
			"working_dir": "$project_path",
			"file_regex": "^\\s*File \"/root/\\.config/sublime-text/Packages/[^/]+/(.+)\", line ([0-9]+)",
		},
		{
			"name": "Mypy (project)",
			"shell_cmd": "uvx mypy@1.16.1 -p GitSavvy",
			"working_dir": "$project_path",
			"file_regex": "^(.+):(\\d+):"
		},
	],
	"folders":
	[
		{
			"folder_exclude_patterns":
			[
				".git",
				"__pycache__"
			],
			"path": ".",
		}
	],
	"settings":
	{
		"GitSavvy":
		{
		},
		"SublimeLinter.linters.mypy.executable": ["uvx", "mypy@1.16.1"],
		"SublimeLinter.linters.mypy.excludes": ["*/tests/*"],
		"rulers":
		[
			100,
			120
		],
		"tab_size": 4,
		"translate_tabs_to_spaces": true,
		"SublimeLinter.linters.flake8.executable": ["uvx", "--python", "3.8", "flake8@5.0.4"],
		"SublimeLinter.linters.ruff.executable": ["uvx", "ruff@0.14.13"],
		"SublimeLinter.linters.ruff-lsp.disable": true,
	},
}
